{
  "extends": "./node_modules/expo/tsconfig.base",
  "compilerOptions": {
    "jsx": "react-native",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["expo", "@react-three/fiber"],
    "paths": {
      "@/*": ["./src/*"],
      "@jink/core-foundation": ["packages/core-foundation/src"],
      "@jink/core-foundation/*": ["packages/core-foundation/src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx"],
  "exclude": ["node_modules", "apps/server/**", "**/dist", "**/build"]
}
