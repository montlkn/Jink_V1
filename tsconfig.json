{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2019",
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "types": ["react-native", "expo-router"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "app.config.*", "src/types/**/*.d.ts"],
  "exclude": [
    "node_modules",
    "ios",
    "android",
    "patches",
    "supabase/functions",
    "dist",
    "build",
    "apps/server/**",
    "**/dist",
    "**/build"
  ]
}
